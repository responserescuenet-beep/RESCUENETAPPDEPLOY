# ============================================================================
#  RescueNet — Apache configuration for the app web root (XAMPP dev / hosting)
#  The PHP backend is exposed at /api by the vhost (Alias -> php-backend/api),
#  NOT as a folder inside www, so Capacitor's `cap sync` never tries to symlink
#  the backend into the APK.
# ============================================================================

RewriteEngine On

# 1) Real files and directories (the static HTML/CSS/JS apps) are served as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2) The Maps SDK key script is generated by the PHP backend (key never in HTML).
RewriteRule ^maps-key\.js$ /api/maps-key.php [L]

# ---- Hardening -------------------------------------------------------------
# Never expose source, keys or schema over HTTP.
<FilesMatch "\.(sql|md|key|log)$">
  Require all denied
</FilesMatch>

# Keep API responses out of every cache.
<IfModule mod_headers.c>
  <FilesMatch "^index\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

# UTF-8 by default.
AddDefaultCharset UTF-8
